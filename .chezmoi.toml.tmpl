{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $github_username := promptStringOnce . "github_username" "GitHub Username" -}}
{{- $profile := promptChoiceOnce . "profile" "Profile (full = macOS zsh + GUI apps, minimal = zsh + core CLI, no GUI/sudo)" (list "full" "minimal") -}}

[data]
    email = {{ $email | quote }}
    github_username = {{ $github_username | quote }}
    profile = {{ $profile | quote }}
