#!/usr/bin/env bash
set -euo pipefail

# yazi package hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}

# ya pkg install shells out to git; skip cleanly if either is missing.
if ! command -v ya &>/dev/null || ! command -v git &>/dev/null; then
    exit 0
fi

echo "Installing yazi plugins..."
ya pkg install
